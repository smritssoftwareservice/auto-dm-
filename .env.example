# DMFlow AI Environment Configuration

# APP MODE: 'demo' | 'development' | 'production'
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# DATABASE (PostgreSQL / Supabase / SQLite local fallback)
DATABASE_URL="file:./dev.db"
DIRECT_URL="file:./dev.db"

# AUTHENTICATION
AUTH_SECRET="dmflow_ai_super_secret_auth_key_32_chars_min"

# 100% FREE & ZERO-COST AI PROVIDER ENGINE
# Options: 'mock' (Smart Zero-Cost Engine) | 'gemini' (Free Google Key) | 'groq' (Free Groq Key) | 'openrouter' | 'openai'
AI_PROVIDER=mock

# 1. GOOGLE GEMINI FREE TIER KEY (Get free key from https://aistudio.google.com/app/apikey - No credit card needed!)
GEMINI_API_KEY=

# 2. GROQ CLOUD FREE TIER KEY (Get free key from https://console.groq.com/keys - No credit card needed!)
GROQ_API_KEY=

# 3. OPENROUTER FREE MODELS KEY (Get free key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 4. OPENAI API KEY (Optional paid key)
AI_API_KEY=sk-demo-key

# META / INSTAGRAM GRAPH API (Optional for live Graph API; Demo simulator works without credentials)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=dmflow_webhook_verify_token_123

# STRIPE BILLING (Test Mode)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
