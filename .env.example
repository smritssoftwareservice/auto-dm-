# DMFlow AI Environment Configuration

# APP MODE: 'demo' | 'development' | 'production'
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# DATABASE (PostgreSQL / Supabase / SQLite for local demo fallback)
DATABASE_URL="file:./dev.db"
DIRECT_URL="file:./dev.db"

# AUTHENTICATION (Supabase / NextAuth / Custom JWT)
AUTH_SECRET="dmflow_ai_super_secret_auth_key_32_chars_min"
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# META / INSTAGRAM GRAPH API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=dmflow_webhook_verify_token_123

# AI PROVIDER ENGINE ('mock' | 'openai' | 'custom')
AI_PROVIDER=mock
AI_API_KEY=sk-demo-key-replaceable-in-prod

# STRIPE BILLING (Test Mode)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
